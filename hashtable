#include <iostream>
using namespace std;

#define SIZE 5
#define EMPTY -1
#define DELETED -2

// ================= SEPARATE CHAINING =================
struct Node {
    int data;
    Node* next;
    Node(int val) {
        data = val;
        next = NULL;
    }
};

class ChainingHash {
    Node* table[SIZE];

public:
    ChainingHash() {
        for (int i = 0; i < SIZE; i++)
            table[i] = NULL;
    }

    int hash(int key) {
        return key % SIZE;
    }

    void insert(int key) {
        int index = hash(key);
        cout << "Insert " << key << " at index " << index << endl;

        Node* newNode = new Node(key);
        newNode->next = table[index];
        table[index] = newNode;
    }

    void search(int key) {
        int index = hash(key);
        Node* temp = table[index];

        while (temp) {
            if (temp->data == key) {
                cout << key << " found in chaining\n";
                return;
            }
            temp = temp->next;
        }
        cout << key << " not found in chaining\n";
    }

    void remove(int key) {
        int index = hash(key);
        Node* temp = table[index];
        Node* prev = NULL;

        while (temp) {
            if (temp->data == key) {
                if (prev)
                    prev->next = temp->next;
                else
                    table[index] = temp->next;

                delete temp;
                cout << key << " deleted from chaining\n";
                return;
            }
            prev = temp;
            temp = temp->next;
        }
    }

    void display() {
        cout << "\nChaining Table:\n";
        for (int i = 0; i < SIZE; i++) {
            cout << i << ": ";
            Node* temp = table[i];
            while (temp) {
                cout << temp->data << " -> ";
                temp = temp->next;
            }
            cout << "NULL\n";
        }
    }
};

// ================= OPEN ADDRESSING =================
class OpenAddressing {
    int table[SIZE];

public:
    OpenAddressing() {
        for (int i = 0; i < SIZE; i++)
            table[i] = EMPTY;
    }

    int hash(int key) {
        return key % SIZE;
    }

    int hash2(int key) {
        return 1 + (key % (SIZE - 1));
    }

    void display() {
        for (int i = 0; i < SIZE; i++)
            cout << i << ": " << table[i] << endl;
    }

    // -------- Linear Probing --------
    void insertLinear(int key) {
        int index = hash(key);

        for (int i = 0; i < SIZE; i++) {
            int newIndex = (index + i) % SIZE;

            if (table[newIndex] == EMPTY || table[newIndex] == DELETED) {
                table[newIndex] = key;
                cout << "Inserted " << key << " at " << newIndex << endl;
                return;
            } else {
                cout << "Collision at " << newIndex << endl;
            }
        }
        cout << "Table full\n";
    }

    void searchLinear(int key) {
        int index = hash(key);

        for (int i = 0; i < SIZE; i++) {
            int newIndex = (index + i) % SIZE;

            if (table[newIndex] == EMPTY)
                break;

            if (table[newIndex] == key) {
                cout << key << " found (Linear)\n";
                return;
            }
        }
        cout << key << " not found\n";
    }

    void deleteLinear(int key) {
        int index = hash(key);

        for (int i = 0; i < SIZE; i++) {
            int newIndex = (index + i) % SIZE;

            if (table[newIndex] == EMPTY)
                break;

            if (table[newIndex] == key) {
                table[newIndex] = DELETED;
                cout << key << " deleted\n";
                return;
            }
        }
    }

    // -------- Quadratic Probing --------
    void insertQuadratic(int key) {
        int index = hash(key);

        for (int i = 0; i < SIZE; i++) {
            int newIndex = (index + i * i) % SIZE;

            if (table[newIndex] == EMPTY || table[newIndex] == DELETED) {
                table[newIndex] = key;
                cout << "Inserted " << key << " at " << newIndex << endl;
                return;
            } else {
                cout << "Collision at " << newIndex << endl;
            }
        }
        cout << "Table full\n";
    }

    // -------- Double Hashing --------
    void insertDouble(int key) {
        int index = hash(key);
        int step = hash2(key);

        for (int i = 0; i < SIZE; i++) {
            int newIndex = (index + i * step) % SIZE;

            if (table[newIndex] == EMPTY || table[newIndex] == DELETED) {
                table[newIndex] = key;
                cout << "Inserted " << key << " at " << newIndex << endl;
                return;
            } else {
                cout << "Collision at " << newIndex << endl;
            }
        }
        cout << "Table full\n";
    }
};

// ================= MAIN =================
int main() {

    int keys[] = {10, 15, 20, 25, 30}; // all collide (mod 5)

    // -------- Chaining --------
    ChainingHash ch;
    for (int i = 0; i < SIZE; i++)
        ch.insert(keys[i]);

    ch.display();
    ch.search(20);
    ch.remove(20);
    ch.display();

    // -------- Linear Probing --------
    cout << "\nLinear Probing:\n";
    OpenAddressing oa1;
    for (int i = 0; i < SIZE; i++)
        oa1.insertLinear(keys[i]);

    oa1.display();
    oa1.searchLinear(25);
    oa1.deleteLinear(25);
    oa1.display();

    // -------- Quadratic Probing --------
    cout << "\nQuadratic Probing:\n";
    OpenAddressing oa2;
    for (int i = 0; i < SIZE; i++)
        oa2.insertQuadratic(keys[i]);
    oa2.display();

    // -------- Double Hashing --------
    cout << "\nDouble Hashing:\n";
    OpenAddressing oa3;
    for (int i = 0; i < SIZE; i++)
        oa3.insertDouble(keys[i]);
    oa3.display();

    return 0;
}
