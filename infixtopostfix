#include <iostream>
#include <stack>
#include <string>
#include <cmath>
using namespace std;

// Function to check precedence of operators
int precedence(char op) {
    if (op == '+' || op == '-') return 1;
    if (op == '*' || op == '/') return 2;
    if (op == '^') return 3;
    return 0;
}

// Function to perform operation
double applyOperator(double a, double b, char op) {
    switch(op) {
        case '+': return a + b;
        case '-': return a - b;
        case '*': return a * b;
        case '/': return a / b;
        case '^': return pow(a, b);
    }
    return 0;
}

// a) Infix to Postfix Conversion
string infixToPostfix(string infix) {
    stack<char> st;
    string postfix = "";

    for (int i = 0; i < infix.length(); i++) {
        char ch = infix[i];

        // If operand (digit)
        if (isdigit(ch)) {
            postfix += ch;
        }
        // If opening bracket
        else if (ch == '(') {
            st.push(ch);
        }
        // If closing bracket
        else if (ch == ')') {
            while (!st.empty() && st.top() != '(') {
                postfix += st.top();
                st.pop();
            }
            st.pop(); // remove '('
        }
        // If operator
        else {
            while (!st.empty() && precedence(st.top()) >= precedence(ch)) {
                postfix += st.top();
                st.pop();
            }
            st.push(ch);
        }
    }

    // Pop remaining operators
    while (!st.empty()) {
        postfix += st.top();
        st.pop();
    }

    return postfix;
}

// b) Postfix Evaluation
double evaluatePostfix(string postfix) {
    stack<double> st;

    for (int i = 0; i < postfix.length(); i++) {
        char ch = postfix[i];

        // If operand
        if (isdigit(ch)) {
            st.push(ch - '0'); // convert char to int
        }
        // If operator
        else {
            double b = st.top(); st.pop();
            double a = st.top(); st.pop();
            double result = applyOperator(a, b, ch);
            st.push(result);
        }
    }

    return st.top();
}

// c) Main Function for Testing
int main() {
    string infix;

    cout << "Enter infix expression: ";
    cin >> infix;

    string postfix = infixToPostfix(infix);
    cout << "Postfix Expression: " << postfix << endl;

    double result = evaluatePostfix(postfix);
    cout << "Evaluation Result: " << result << endl;

    return 0;
}
