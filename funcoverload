#include<iostream>
#include<string>
using namespace std;
int add(int a, int b){
    return a+b;
}
float add(float a, float b){
    return a+b;
}
template <class T>
void swapValues(T &a, T &b){
    T temp;
    temp=a;
    a=b;
    b=temp;
}
int main(){
    int p,q;
    float x,y;
    cout<<"Enter two integer values: ";
    cin>>p>>q;
    cout<<"Sum of integer values: "<<add(p,q)<<endl;
    cout<<"Enter two float values: ";
    cin>>x>>y;
    cout<<"Sum of float values: "<<add(x,y)<<endl;
    int a=10,b=20;
    float c=12.50, d=50.12;
    string s1="DS", s2="External";
    cout<<"Before swapping integers: "<<a<<" "<<b<<endl;
    swapValues(a,b);
    cout<<"After swapping integers: "<<a<<" "<<b<<endl;
    cout<<"Before swapping floats: "<<c<<" "<<d<<endl;
    swapValues(c,d);
    cout<<"After swapping floats: "<<c<<" "<<d<<endl;
    cout<<"Before swapping strings: "<<s1<<" "<<s2<<endl;
    swapValues(s1,s2);
    cout<<"After swapping strings: "<<s1<<" "<<s2<<endl;
}
