b = float(input("Enter upper limit (b): "))
fa = f(a)
fb = f(b)
print("f(a) =", fa)
print("f(b) =", fb)
if fa * fb < 0:
 print("Root lies in the interval [", a, ",", b, "]")
elif fa == 0:
 print("a is the root.")
elif fb == 0:
 print("b is the root.")
else:
 print("No root exists in the given interval.")
 exit()
print("\nIteration\tc")
for i in range(50):
 c = (a + b) / 2
 print(i, "\t\t", format(c, ".5f"))
 if f(a) * f(c) < 0:
 b = c
 else:
 a = c
 next_c = (a + b) / 2
 if round(c, 4) == round(next_c, 4):
 break
print("\nNumber of iterations =", i)
print("Root =", format(c, ".4f"))
# Plot the graph
x = np.linspace(-2, 5)
y = f(x)
plt.plot(x, y, color='orange', label=r'$f(x)=x^3-x^2-1$')
