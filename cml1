import numpy as np
A = np.array([[2, 1],[4, 5]])
# Check if matrix is square
if A.shape[0] != A.shape[1]:
 print("It is not square matrix!")
else:
 # Compute eigenvalues
 eigenvalues = np.linalg.eigvals(A)
 eigenvalues=np.real_if_close(eigenvalues)
 print("\nMatrix A:")
 print(A)
 print("\nEigenvalues:")
 print(eigenvalues)
 # Check nature of eigenvalues
 print("\nNature of Eigenvalues:")
 for i, val in enumerate(eigenvalues):
 if np.iscomplex(val):
 print(f"Eigenvalue {i+1}: {val} → Complex")
 else:
 print(f"Eigenvalue {i+1}: {val} → Real")
