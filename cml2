import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D
A = np.array([[1,1,1], [0,2,1], [-4,4,3]])
eigenvalues, eigenvectors = np.linalg.eig(A)
eigenvalues = np.real_if_close(eigenvalues)
eigenvectors = np.real_if_close(eigenvectors)
print("Matrix A:")
print(A)
print("\nEigen Values and corresponding Eigen Vectors:")
for i in range(len(eigenvalues)):
 print(f"\nEigenvalue {i+1}: {eigenvalues[i]}")
 print("Corresponding Eigenvector:")
 print(eigenvectors[:, i].reshape(-1, 1))
colors = ['blue', 'red', 'green']
# Create 3D figure
fig = plt.figure(figsize=(7,7))
ax = fig.add_subplot(111, projection='3d')
# Plot eigenvectors
for i in range(len(eigenvalues)):
 ax.quiver(0, 0, 0,
 eigenvectors[0,i],
 eigenvectors[1,i],
 eigenvectors[2,i],
 color=colors[i],
 length=1,
 normalize=True,
 label=f"Eigenvector {i+1}")
ax.set_xlabel("X-axis")
ax.set_ylabel("Y-axis")
ax.set_zlabel("Z-axis")
ax.set_title("3D Plot of Eigenvectors")
plt.legend()
plt.show()
