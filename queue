#include <iostream>
using namespace std;

#define MAX 5

/******************** QUEUE USING ARRAY ********************/
class QueueArray {
    int arr[MAX];
    int front, rear;

public:
    QueueArray() {
        front = -1;
        rear = -1;
    }

    void enqueue(int value) {
        if (rear == MAX - 1) {
            cout << "Queue Overflow\n";
            return;
        }

        if (front == -1)
            front = 0;

        arr[++rear] = value;
        cout << value << " inserted into queue (Array)\n";
    }

    void dequeue() {
        if (front == -1 || front > rear) {
            cout << "Queue Underflow\n";
            return;
        }

        cout << arr[front] << " deleted from queue (Array)\n";
        front++;
    }

    void display() {
        if (front == -1 || front > rear) {
            cout << "Queue is Empty\n";
            return;
        }

        cout << "Queue using Array: ";
        for (int i = front; i <= rear; i++)
            cout << arr[i] << " ";
        cout << endl;
    }
};


/******************** QUEUE USING LINKED LIST ********************/
struct Node {
    int data;
    Node* next;
};

class QueueLinkedList {
    Node *front, *rear;

public:
    QueueLinkedList() {
        front = rear = NULL;
    }

    void enqueue(int value) {
        Node* temp = new Node();
        temp->data = value;
        temp->next = NULL;

        if (rear == NULL) {
            front = rear = temp;
        } else {
            rear->next = temp;
            rear = temp;
        }

        cout << value << " inserted into queue (Linked List)\n";
    }

    void dequeue() {
        if (front == NULL) {
            cout << "Queue Underflow\n";
            return;
        }

        Node* temp = front;
        cout << temp->data << " deleted from queue (Linked List)\n";
        front = front->next;

        if (front == NULL)
            rear = NULL;

        delete temp;
    }

    void display() {
        if (front == NULL) {
            cout << "Queue is Empty\n";
            return;
        }

        Node* temp = front;
        cout << "Queue using Linked List: ";
        while (temp != NULL) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
};


/******************** MAIN FUNCTION ********************/
int main() {

    QueueArray qa;
    QueueLinkedList ql;

    cout << "\n--- Queue using Array ---\n";
    qa.enqueue(10);
    qa.enqueue(20);
    qa.enqueue(30);
    qa.display();

    qa.dequeue();
    qa.display();


    cout << "\n--- Queue using Linked List ---\n";
    ql.enqueue(100);
    ql.enqueue(200);
    ql.enqueue(300);
    ql.display();

    ql.dequeue();
    ql.display();

    return 0;
}

